# Environment configuration for ContractLens Backend (Google Gemini AI)

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini API Configuration
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Hosted Gemini Embedding Configuration
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSION=768

# Document Upload & In-Memory FAISS Chunk Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ==============================================================================
# Model Context Protocol (MCP) Configuration for External Legal Web-Search
# ==============================================================================
# Toggle MCP integration (true = enable live search, false = contract-only RAG)
MCP_ENABLED=false

# Transport: "stdio" (subprocess via command line) or "sse" (HTTP Server-Sent Events)
MCP_TRANSPORT=stdio

# Option A: Brave Search MCP Server (Standard official MCP search tool)
# Requires npm / npx installed on host. Run with your Brave Search API key.
MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS=-y @modelcontextprotocol/server-brave-search
# Optional JSON string containing environment variables for the MCP subprocess:
# MCP_SERVER_ENV={"BRAVE_API_KEY":"your_brave_api_key_here"}

# Option B: For SSE transport instead of stdio:
# MCP_TRANSPORT=sse
# MCP_SERVER_URL=http://localhost:8080/sse

# Allowlist of approved research tools to prevent arbitrary execution
MCP_ALLOWED_TOOLS=brave_web_search,brave_local_search,duckduckgo_search,web_search,fetch,fetch_page

# Timeout in seconds for MCP tool discovery and execution
MCP_TIMEOUT_SECONDS=15.0

# Maximum tool call rounds per user query to prevent infinite loops
MCP_MAX_TOOL_CALLS=3
