# Root Environment Template for ContractLens (Google Gemini AI + MCP)

# Google Gemini API Settings (Get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Hosted Gemini Embedding Model
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSION=768

# Frontend Settings
VITE_API_URL=http://localhost:8000

# Model Context Protocol (MCP) External Legal Research
MCP_ENABLED=false
MCP_TRANSPORT=stdio
MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS=-y @modelcontextprotocol/server-brave-search
# MCP_SERVER_ENV={"BRAVE_API_KEY":"your_brave_api_key_here"}
MCP_ALLOWED_TOOLS=brave_web_search,brave_local_search,duckduckgo_search,web_search,fetch,fetch_page
MCP_TIMEOUT_SECONDS=15.0
MCP_MAX_TOOL_CALLS=3
